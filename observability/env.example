# Copy to repo root as `.env.observability` (gitignored) or pass with:
#   docker compose --env-file observability/env.example --profile observability up -d
#
# --- Alertmanager → Slack (Incoming Webhook) ---
# Local default: blackhole (nothing useful listens on :9).
# Create at https://api.slack.com/messaging/webhooks → pick channel → copy URL.
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9/alertmanager-webhook

# Slack example:
# ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Discord (optional): channel webhook URL + append /slack
# ALERTMANAGER_WEBHOOK_URL=https://discord.com/api/webhooks/.../slack
